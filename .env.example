# ── Database ──────────────────────────────────────────────
# Local (pnpm db:start, embedded PostgreSQL on port 5433):
DATABASE_URL="postgresql://burger:burger_dev_password@localhost:5433/blacksmoke"
# Docker Compose uses these instead:
POSTGRES_USER=burger
POSTGRES_PASSWORD=change-me
POSTGRES_DB=blacksmoke

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 48   (min. 32 chars; dev-only values are rejected in production)
BETTER_AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef0123456789"
UPLOAD_DIR="./storage/uploads"
# Only "true" behind a reverse proxy that sets X-Forwarded-For (used for rate limiting).
TRUST_PROXY="false"

# ── Seed (admin user) ─────────────────────────────────────
# Required when NODE_ENV=production; dev defaults: admin@blacksmoke.dev / BlackSmoke#2026
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Mercado Pago (optional) ───────────────────────────────
# Without MP_ACCESS_TOKEN, Pix/online card are hidden and only pay-on-delivery is offered.
# Sandbox tokens start with TEST-. Webhook secret: Mercado Pago dashboard → Webhooks → "Assinatura secreta".
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
